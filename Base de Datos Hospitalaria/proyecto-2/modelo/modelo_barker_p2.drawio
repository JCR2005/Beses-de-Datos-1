<mxfile host="app.diagrams.net"><diagram id="er-hospitales" name="Modelo ER Barker - Proyecto 2"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Hospitales de Occidente — Modelo entidad-relación extendido del Proyecto 2 (notación Barker / pata de gallo)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="36" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;# &lt;/b&gt;llave primaria &amp;nbsp;&amp;nbsp; &lt;b&gt;*&lt;/b&gt; obligatorio &amp;nbsp;&amp;nbsp; &lt;b&gt;o&lt;/b&gt; opcional &amp;nbsp;&amp;nbsp; (FK) llave foránea &amp;nbsp;&amp;nbsp; (UK) único &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; línea continua = FK obligatoria, discontinua = FK opcional, pata de gallo = lado «muchos»&lt;br&gt;&lt;span style=&quot;color:#5C6BC0&quot;&gt;■&lt;/span&gt; Geografía &amp;nbsp; &lt;span style=&quot;color:#1E88E5&quot;&gt;■&lt;/span&gt; Catálogo hospitalario &amp;nbsp; &lt;span style=&quot;color:#43A047&quot;&gt;■&lt;/span&gt; Pacientes &amp;nbsp; &lt;span style=&quot;color:#F9A825&quot;&gt;■&lt;/span&gt; Consulta externa &amp;nbsp; &lt;span style=&quot;color:#FB8C00&quot;&gt;■&lt;/span&gt; Ingreso / egreso / hospitalización &amp;nbsp; &lt;span style=&quot;color:#D81B60&quot;&gt;■&lt;/span&gt; Cirugía &amp;nbsp; &lt;span style=&quot;color:#8E24AA&quot;&gt;■&lt;/span&gt; Facturación &amp;nbsp; &lt;span style=&quot;color:#00897B&quot;&gt;■&lt;/span&gt; Proyecto 2: supertipo PERSONAL y auditoría&lt;br/&gt;Recuadro &lt;b&gt;PERSONAL&lt;/b&gt; = supertipo; &lt;b&gt;MEDICO&lt;/b&gt; y &lt;b&gt;ENFERMERO&lt;/b&gt; dentro son sus subtipos (una tabla por supertipo y por subtipo, con la misma llave primaria). &amp;nbsp; Línea naranja «superior directo» = relación recursiva de MEDICO. &amp;nbsp; [P2] = atributo agregado en el Proyecto 2." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="2600" height="66" as="geometry" /></mxCell><mxCell id="t_departamento" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;DEPARTAMENTO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#5C6BC0&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_departamento&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E8EAF6;strokeColor=#5C6BC0;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="0" y="170" width="300" height="74" as="geometry" /></mxCell><mxCell id="t_municipio" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;MUNICIPIO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#5C6BC0&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_municipio&lt;/b&gt;&lt;br/&gt;* id_departamento (FK)&lt;br/&gt;* nombre&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E8EAF6;strokeColor=#5C6BC0;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="300" height="89" as="geometry" /></mxCell><mxCell id="t_hospital" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;HOSPITAL&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_hospital&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;o informacion_especifica&lt;br/&gt;* direccion&lt;br/&gt;* id_municipio (FK)&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1600" y="170" width="300" height="119" as="geometry" /></mxCell><mxCell id="t_unidad_medica" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;UNIDAD_MEDICA&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_unidad&lt;/b&gt;&lt;br/&gt;* id_hospital (FK)&lt;br/&gt;* tipo_unidad&lt;br/&gt;o costo_dia_hospitalizacion&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2000" y="170" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_servicio_atencion" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;SERVICIO_ATENCION&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_servicio&lt;/b&gt;&lt;br/&gt;* id_unidad (FK)&lt;br/&gt;* nombre&lt;br/&gt;* costo&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2400" y="170" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_especialidad" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;ESPECIALIDAD&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_especialidad&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;* tipo&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="300" height="89" as="geometry" /></mxCell><mxCell id="t_camilla" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;CAMILLA&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_camilla&lt;/b&gt;&lt;br/&gt;* id_unidad (FK)&lt;br/&gt;* numero&lt;br/&gt;* disponible&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2800" y="170" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_quirofano" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;QUIROFANO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_quirofano&lt;/b&gt;&lt;br/&gt;* id_unidad (FK)&lt;br/&gt;* numero&lt;br/&gt;* estado&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1200" y="170" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_personal" value="&lt;div style=&quot;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;PERSONAL&lt;/b&gt; (supertipo) [P2]&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#00897B&quot;/&gt;&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding-right:24px;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_personal&lt;/b&gt;&lt;br/&gt;* tipo_personal&lt;br/&gt;* nombres&lt;br/&gt;* apellidos&lt;br/&gt;* dpi (UK)&lt;br/&gt;o telefono&lt;br/&gt;* direccion&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-right:24px;line-height:15px;font-size:11px&quot;&gt;* id_municipio (FK)&lt;br/&gt;* area&lt;br/&gt;* id_hospital (FK)&lt;br/&gt;o fecha_contratacion&lt;br/&gt;o salario&lt;br/&gt;* nivel_acceso&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;margin-top:6px;line-height:13px;font-size:10px;color:#00695C&quot;&gt;&lt;b&gt;Estrategia de mapeo:&lt;/b&gt; tabla por supertipo y por subtipo. PERSONAL guarda los datos comunes y el discriminador tipo_personal; MEDICO y ENFERMERO comparten su llave (id_medico = id_enfermero = id_personal) mediante una FK compuesta (id, tipo_personal). Es exclusiva (cada persona es de un solo subtipo) y completa (toda persona tiene su subtipo).&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;spacingRight=12;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="780" y="340" width="760" height="460" as="geometry" /></mxCell><mxCell id="t_medico" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;MEDICO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_medico (FK)&lt;/b&gt;&lt;br/&gt;* id_especialidad (FK)&lt;br/&gt;* tipo_medico&lt;br/&gt;o costo_primera_consulta&lt;br/&gt;o horario_inicio&lt;br/&gt;o horario_fin&lt;br/&gt;* cargo [P2]&lt;br/&gt;o id_medico_superior (FK) [P2]&lt;br/&gt;&lt;i&gt;datos comunes: ver PERSONAL&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="800" y="399" width="300" height="179" as="geometry" /></mxCell><mxCell id="t_enfermero" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;ENFERMERO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_enfermero (FK)&lt;/b&gt;&lt;br/&gt;* tipo&lt;br/&gt;&lt;i&gt;datos comunes: ver PERSONAL&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1200" y="420" width="300" height="89" as="geometry" /></mxCell><mxCell id="t_insumo" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;INSUMO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_insumo&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;o descripcion&lt;br/&gt;o material&lt;br/&gt;* tipo&lt;br/&gt;* unidad_medida&lt;br/&gt;* costo_unitario&lt;br/&gt;* stock_minimo&lt;br/&gt;* stock_actual&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1200" y="2385" width="300" height="179" as="geometry" /></mxCell><mxCell id="t_instrumento" valu
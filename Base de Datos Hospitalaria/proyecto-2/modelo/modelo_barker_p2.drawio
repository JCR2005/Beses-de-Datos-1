<mxfile host="app.diagrams.net"><diagram id="er-hospitales" name="Modelo ER Barker - Proyecto 2"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Hospitales de Occidente — Modelo entidad-relación extendido del Proyecto 2 (notación Barker / pata de gallo)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="36" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;# &lt;/b&gt;llave primaria &amp;nbsp;&amp;nbsp; &lt;b&gt;*&lt;/b&gt; obligatorio &amp;nbsp;&amp;nbsp; &lt;b&gt;o&lt;/b&gt; opcional &amp;nbsp;&amp;nbsp; (FK) llave foránea &amp;nbsp;&amp;nbsp; (UK) único &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; línea continua = FK obligatoria, discontinua = FK opcional, pata de gallo = lado «muchos»&lt;br&gt;&lt;span style=&quot;color:#5C6BC0&quot;&gt;■&lt;/span&gt; Geografía &amp;nbsp; &lt;span style=&quot;color:#1E88E5&quot;&gt;■&lt;/span&gt; Catálogo hospitalario &amp;nbsp; &lt;span style=&quot;color:#43A047&quot;&gt;■&lt;/span&gt; Pacientes &amp;nbsp; &lt;span style=&quot;color:#F9A825&quot;&gt;■&lt;/span&gt; Consulta externa &amp;nbsp; &lt;span style=&quot;color:#FB8C00&quot;&gt;■&lt;/span&gt; Ingreso / egreso / hospitalización &amp;nbsp; &lt;span style=&quot;color:#D81B60&quot;&gt;■&lt;/span&gt; Cirugía &amp;nbsp; &lt;span style=&quot;color:#8E24AA&quot;&gt;■&lt;/span&gt; Facturación &amp;nbsp; &lt;span style=&quot;color:#00897B&quot;&gt;■&lt;/span&gt; Proyecto 2: tablas nuevas (supertipo, auditoría, catálogos, clínicas y laboratorio)&lt;br/&gt;Recuadro &lt;b&gt;PERSONAL&lt;/b&gt; = supertipo; &lt;b&gt;MEDICO&lt;/b&gt; y &lt;b&gt;ENFERMERO&lt;/b&gt; dentro son sus subtipos (una tabla por supertipo y por subtipo, con la misma llave primaria). &amp;nbsp; Línea naranja «superior directo» = relación recursiva de MEDICO. &amp;nbsp; [P2] = atributo agregado en el Proyecto 2." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="3740" height="66" as="geometry" /></mxCell><mxCell id="t_departamento" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;DEPARTAMENTO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#5C6BC0&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_departamento&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E8EAF6;strokeColor=#5C6BC0;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="300" height="74" as="geometry" /></mxCell><mxCell id="t_municipio" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;MUNICIPIO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#5C6BC0&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_municipio&lt;/b&gt;&lt;br/&gt;* id_departamento (FK)&lt;br/&gt;* nombre&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E8EAF6;strokeColor=#5C6BC0;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="0" y="284" width="300" height="89" as="geometry" /></mxCell><mxCell id="t_hospital" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;HOSPITAL&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_hospital&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;o informacion_especifica&lt;br/&gt;* direccion&lt;br/&gt;* id_municipio (FK)&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="300" height="119" as="geometry" /></mxCell><mxCell id="t_unidad_medica" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;UNIDAD_MEDICA&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_unidad&lt;/b&gt;&lt;br/&gt;* id_hospital (FK)&lt;br/&gt;* tipo_unidad&lt;br/&gt;o costo_dia_hospitalizacion&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="430" y="329" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_servicio_atencion" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;SERVICIO_ATENCION&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_servicio&lt;/b&gt;&lt;br/&gt;* id_unidad (FK)&lt;br/&gt;* nombre&lt;br/&gt;* costo&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_especialidad" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;ESPECIALIDAD&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_especialidad&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;* tipo&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1290" y="150" width="300" height="89" as="geometry" /></mxCell><mxCell id="t_camilla" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;CAMILLA&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_camilla&lt;/b&gt;&lt;br/&gt;* id_unidad (FK)&lt;br/&gt;* numero&lt;br/&gt;* disponible&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="860" y="314" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_quirofano" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;QUIROFANO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_quirofano&lt;/b&gt;&lt;br/&gt;* id_unidad (FK)&lt;br/&gt;* numero&lt;br/&gt;* estado&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="430" y="493" width="300" height="104" as="geometry" /></mxCell><mxCell id="t_personal" value="&lt;div style=&quot;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;PERSONAL&lt;/b&gt; (supertipo) [P2]&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#00897B&quot;/&gt;&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding-right:24px;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_personal&lt;/b&gt;&lt;br/&gt;* tipo_personal&lt;br/&gt;* nombres&lt;br/&gt;* apellidos&lt;br/&gt;* dpi (UK)&lt;br/&gt;o telefono&lt;br/&gt;* direccion&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding-right:24px;line-height:15px;font-size:11px&quot;&gt;* id_municipio (FK)&lt;br/&gt;* area&lt;br/&gt;* id_hospital (FK)&lt;br/&gt;o fecha_contratacion&lt;br/&gt;o salario&lt;br/&gt;* nivel_acceso&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;margin-top:6px;line-height:13px;font-size:10px;color:#00695C&quot;&gt;&lt;b&gt;Estrategia de mapeo:&lt;/b&gt; tabla por supertipo y por subtipo. PERSONAL guarda los datos comunes y el discriminador tipo_personal; MEDICO y ENFERMERO comparten su llave (id_medico = id_enfermero = id_personal) mediante una FK compuesta (id, tipo_personal). Es exclusiva (cada persona es de un solo subtipo) y completa (todo el personal es médico o enfermero).&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;spacingRight=12;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1720" y="150" width="810" height="569" as="geometry" /></mxCell><mxCell id="t_insumo" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;INSUMO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_insumo&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;o descripcion&lt;br/&gt;o material&lt;br/&gt;* tipo&lt;br/&gt;* unidad_medida&lt;br/&gt;* costo_unitario&lt;br/&gt;* stock_minimo&lt;br/&gt;* stock_actual&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2580" y="150" width="300" height="179" as="geometry" /></mxCell><mxCell id="t_instrumento" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;INSTRUMENTO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_instrumento&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;o descripcion&lt;br/&gt;* tipo&lt;br/&gt;* funcion (FK)&lt;br/&gt;* estado&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="3010" y="150" width="300" height="134" as="geometry" /></mxCell><mxCell id="t_equipo" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;EQUIPO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#1E88E5&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_equipo&lt;/b&gt;&lt;br/&gt;* nombre (UK)&lt;br/&gt;o descripcion&lt;br/&gt;* tipo&lt;br/&gt;* funcion (FK)&lt;br/&gt;* estado&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="3010" y="478" width="300" height="134" as="geometry" /></mxCell><mxCell id="t_paciente" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;PACIENTE&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#43A047&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_paciente&lt;/b&gt;&lt;br/&gt;* numero_expediente (UK)&lt;br/&gt;* nombres&lt;br/&gt;* apellidos&lt;br/&gt;* fecha_nacimiento&lt;br/&gt;* sexo&lt;br/&gt;o dpi (UK)&lt;br/&gt;o telefono&lt;br/&gt;* id_municipio (FK)&lt;br/&gt;* area&lt;br/&gt;o id_estado_civil (FK)&lt;br/&gt;o numero_seguro_social&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="430" y="1113" width="300" height="224" as="geometry" /></mxCell><mxCell id="t_encargado" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;ENCARGADO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#43A047&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_encargado&lt;/b&gt;&lt;br/&gt;* nombres&lt;br/&gt;* apellidos&lt;br/&gt;* dpi (UK)&lt;br/&gt;o telefono&lt;br/&gt;* id_municipio (FK)&lt;br/&gt;* area&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=4;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="0" y="1381" width="300" height="149" as="geometry" /></mxCell><mxCell id="t_paciente_encargado" value="&lt;div style=&quot;text-align:center;line-height:20px;font-size:12px&quot;&gt;&lt;b&gt;PACIENTE_ENCARGADO&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0;border-color:#43A047&quot;/&gt;&lt;div style=&quot;line-height:15px;font-size:11px&quot;&gt;&lt;b&gt;# id_paciente (FK)&lt;/b&gt;&lt;br/&gt;&lt;b&gt;# id_encargado (FK)&lt;/b&gt;&lt;br/&gt;* id_parentesco (FK)&lt;/div&gt;" sty
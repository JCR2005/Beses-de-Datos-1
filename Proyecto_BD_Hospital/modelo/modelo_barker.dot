digraph modelo {
  graph [rankdir=TB, fontname="Helvetica", splines=true, overlap=false, nodesep=0.35, ranksep=1.1, label="Hospitales de Occidente - Modelo de datos (notación Barker)", labelloc=t, fontsize=26];
  node [shape=plaintext, fontname="Helvetica"];
  edge [color="#444444", penwidth=1.1];
  subgraph cluster_0 { label="Geografía"; style="rounded,filled"; fillcolor="#eef3fb"; color="#999999"; fontsize=18;
    "departamento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>DEPARTAMENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_departamento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR></TABLE>>];
    "municipio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>MUNICIPIO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_municipio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 { label="Hospital"; style="rounded,filled"; fillcolor="#eef8f0"; color="#999999"; fontsize=18;
    "hospital" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>HOSPITAL</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_hospital</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o informacion_especifica</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* direccion</FONT></TD></TR></TABLE>>];
    "unidad_medica" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>UNIDAD_MEDICA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_unidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo_unidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o costo_dia_hospitalizacion</FONT></TD></TR></TABLE>>];
    "servicio_atencion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>SERVICIO_ATENCION</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_servicio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* costo</FONT></TD></TR></TABLE>>];
    "camilla" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CAMILLA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_camilla</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* numero</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* disponible</FONT></TD></TR></TABLE>>];
    "quirofano" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>QUIROFANO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_quirofano</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* numero</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_2 { label="Personal"; style="rounded,filled"; fillcolor="#fdf5e6"; color="#999999"; fontsize=18;
    "especialidad" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>ESPECIALIDAD</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_especialidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo</FONT></TD></TR></TABLE>>];
    "medico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>MEDICO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_medico</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombres</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* apellidos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* dpi</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o telefono</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* area</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo_medico</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o costo_primera_consulta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o horario_inicio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o horario_fin</FONT></TD></TR></TABLE>>];
    "enfermero" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>ENFERMERO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_enfermero</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombres</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* apellidos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* dpi</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o telefono</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo</FONT></TD></TR></TABLE>>];
    "turno_emergencia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>TURNO_EMERGENCIA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_turno</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* jornada</FONT></TD></TR></TABLE>>];
    "turno_medico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>TURNO_MEDICO</B></TD></TR></TABLE>>];
  }
  subgraph cluster_3 { label="Recursos"; style="rounded,filled"; fillcolor="#f4f0fa"; color="#999999"; fontsize=18;
    "insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>INSUMO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_insumo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o descripcion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o material</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* unidad_medida</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* costo_unitario</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* stock_minimo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* stock_actual</FONT></TD></TR></TABLE>>];
    "instrumento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>INSTRUMENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_instrumento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o descripcion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* funcion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR></TABLE>>];
    "equipo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>EQUIPO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_equipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o descripcion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* funcion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR></TABLE>>];
    "medicamento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>MEDICAMENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_medicamento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre_generico</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* concentracion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* forma_farmaceutica</FONT></TD></TR></TABLE>>];
    "diagnostico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>DIAGNOSTICO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_diagnostico</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* codigo_cie10</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* descripcion</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_4 { label="Pacientes"; style="rounded,filled"; fillcolor="#fbeff2"; color="#999999"; fontsize=18;
    "estado_civil" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>ESTADO_CIVIL</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_estado_civil</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR></TABLE>>];
    "parentesco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>PARENTESCO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_parentesco</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR></TABLE>>];
    "paciente" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>PACIENTE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_paciente</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* numero_expediente</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombres</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* apellidos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_nacimiento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* sexo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o dpi</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o telefono</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* area</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o numero_seguro_social</FONT></TD></TR></TABLE>>];
    "encargado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>ENCARGADO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_encargado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombres</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* apellidos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* dpi</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o telefono</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* area</FONT></TD></TR></TABLE>>];
    "paciente_encargado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>PACIENTE_ENCARGADO</B></TD></TR></TABLE>>];
    "calificacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CALIFICACION</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_calificacion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* puntuacion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o comentario</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_5 { label="Consulta externa"; style="rounded,filled"; fillcolor="#eef8f8"; color="#999999"; fontsize=18;
    "cita" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CITA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_cita</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_hora</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* numero_clinica</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* medio_asignacion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* es_reconsulta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* es_referido</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* cancelada_sin_aviso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* costo_base</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* costo_final</FONT></TD></TR></TABLE>>];
    "consulta" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CONSULTA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_consulta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o otros_datos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o notas_observaciones</FONT></TD></TR></TABLE>>];
    "receta" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>RECETA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_receta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o fecha_proxima_cita</FONT></TD></TR></TABLE>>];
    "receta_medicamento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>RECETA_MEDICAMENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* dosis</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* duracion</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_6 { label="Fichas"; style="rounded,filled"; fillcolor="#f7f7ea"; color="#999999"; fontsize=18;
    "ingreso" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>INGRESO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_ingreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_hora_ingreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* motivo_ingreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o diagnostico_presuntivo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o prioridad_triage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o turnos_espera</FONT></TD></TR></TABLE>>];
    "egreso" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>EGRESO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_egreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_hora_egreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* motivo_egreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* codigo_egreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* sin_consentimiento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o motivo_sin_consentimiento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o codigo_traslado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* referido_otro_hospital</FONT></TD></TR></TABLE>>];
    "egreso_diagnostico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>EGRESO_DIAGNOSTICO</B></TD></TR></TABLE>>];
    "institucion_externa" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>INSTITUCION_EXTERNA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_institucion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* direccion</FONT></TD></TR></TABLE>>];
    "traslado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>TRASLADO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_traslado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_hora</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo_traslado</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_7 { label="Cirugía"; style="rounded,filled"; fillcolor="#fdf0ea"; color="#999999"; fontsize=18;
    "tipo_anestesia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>TIPO_ANESTESIA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_tipo_anestesia</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR></TABLE>>];
    "tipo_cirugia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>TIPO_CIRUGIA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_tipo_cirugia</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR></TABLE>>];
    "aspecto_quirurgico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>ASPECTO_QUIRURGICO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_aspecto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* etapa</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* seccion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo_evaluacion</FONT></TD></TR></TABLE>>];
    "rol_quirurgico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>ROL_QUIRURGICO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_rol</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tipo_personal</FONT></TD></TR></TABLE>>];
    "agendamiento_quirurgico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>AGENDAMIENTO_QUIRURGICO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_agendamiento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* caracter</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* resumen_clinico</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* tiempo_estimado_min</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_hora_solicitud</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado_solicitud</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o motivo_rechazo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o fecha_hora_agendada</FONT></TD></TR></TABLE>>];
    "requerimiento_insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>REQUERIMIENTO_INSUMO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* cantidad</FONT></TD></TR></TABLE>>];
    "requerimiento_instrumento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>REQUERIMIENTO_INSTRUMENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* cantidad</FONT></TD></TR></TABLE>>];
    "requerimiento_equipo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>REQUERIMIENTO_EQUIPO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* cantidad</FONT></TD></TR></TABLE>>];
    "historia_clinica" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>HISTORIA_CLINICA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_historia_clinica</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fuente_interrogatorio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o religion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o ocupacion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o lugar_nacimiento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o lugar_residencia</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* antecedentes_heredofamiliares</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* antecedentes_personales_no_patologicos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* antecedentes_patologicos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* padecimiento_actual</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o interrogatorio_aparatos_sistemas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o sintomas_generales_terapeutica</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o estudios_previos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o signos_vitales</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o exploracion_general</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o exploracion_sistematizada</FONT></TD></TR></TABLE>>];
    "consentimiento_informado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CONSENTIMIENTO_INFORMADO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_consentimiento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* procedimiento_nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* procedimiento_objetivo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* procedimiento_caracteristicas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* procedimiento_riesgos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* medico_firmo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* firmante_nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* firmante_relacion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* firmante_firmo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_obtencion</FONT></TD></TR></TABLE>>];
    "chequeo_preanestesico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CHEQUEO_PREANESTESICO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_chequeo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* clasificacion_asa</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* plan_anestesia</FONT></TD></TR></TABLE>>];
    "cirugia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CIRUGIA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_cirugia</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_hora_inicio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o fecha_hora_fin</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o condicion_evolucion</FONT></TD></TR></TABLE>>];
    "cirugia_personal" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CIRUGIA_PERSONAL</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_cirugia_personal</FONT></TD></TR></TABLE>>];
    "registro_procedimiento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>REGISTRO_PROCEDIMIENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_registro</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* resultado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o descripcion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_hora_registro</FONT></TD></TR></TABLE>>];
    "documentacion_etapa" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>DOCUMENTACION_ETAPA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* etapa</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_envio</FONT></TD></TR></TABLE>>];
    "cirugia_insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>CIRUGIA_INSUMO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* costo_unitario</FONT></TD></TR></TABLE>>];
  }

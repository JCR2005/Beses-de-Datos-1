    "pago" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white"><TR><TD><B>PAGO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">#* id_pago</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* numero_cuota</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* monto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* fecha_pago</FONT></TD></TR></TABLE>>];
  }

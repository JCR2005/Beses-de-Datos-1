  "encargado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>ENCARGADO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_encargado</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(dpi)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(telefono)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(municipio_id)</FONT> *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(area)</FONT></FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];

  "consulta" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CONSULTA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_consulta</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">cita_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">paciente_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">medico_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">fecha</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">diagnostico</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(otros_datos)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(notas_observaciones)</FONT></FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "departamento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>DEPARTAMENTO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_departamento</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">nombre</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];

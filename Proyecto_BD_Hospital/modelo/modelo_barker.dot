digraph hospital {
rankdir=LR;
graph [fontname="Helvetica", splines=ortho, nodesep=0.3, ranksep=1.0];
node [shape=plaintext];
edge [dir=back, arrowhead=vee, arrowtail=crow, arrowsize=0.7, style=solid];
  "agendamiento_quirurgico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>AGENDAMIENTO_QUIRURGICO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_agendamiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_cirujano_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* caracter</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o historia_clinica</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* tipo_procedimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* tiempo_estimado_min</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* tipo_anestesia</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_hora_solicitud</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* estado_solicitud</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o motivo_rechazo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o quirofano_solicitado_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o fecha_hora_agendada</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "camilla" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CAMILLA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_camilla</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* hospital_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* unidad_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* numero</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* disponible</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "chequeo_preanestesico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CHEQUEO_PREANESTESICO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_chequeo_preanestesico</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* agendamiento_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* clasificacion_asa</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_asa_nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* plan_anestesia</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* anestesista_nombre</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "cirugia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CIRUGIA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_cirugia</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* agendamiento_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* quirofano_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cirujano_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o ingreso_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_hora_inicio</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o fecha_hora_fin</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o condicion_evolucion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* estado</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "cirugia_insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CIRUGIA_INSUMO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_cirugia_insumo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cirugia_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* insumo_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cantidad</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* costo_unitario</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];
  "cirugia_personal" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CIRUGIA_PERSONAL</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_cirugia_personal</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cirugia_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o medico_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o enfermero_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* rol</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];
  "cita" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CITA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_cita</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_hora</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* num_clinica</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o medio_asignacion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* estado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* es_reconsulta</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* es_referido</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o costo_base</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o costo_aplicado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cancelada_sin_aviso</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "consentimiento_informado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CONSENTIMIENTO_INFORMADO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_consentimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* agendamiento_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* procedimiento_nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* procedimiento_objetivo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* procedimiento_caracteristicas</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* procedimiento_riesgos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_firmado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_firma_nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_firmado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_obtencion</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "consulta" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CONSULTA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_consulta</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* cita_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* diagnostico</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o otros_datos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o notas_observaciones</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "departamento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>DEPARTAMENTO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_departamento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* nombre</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "egreso" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>EGRESO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_egreso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* ingreso_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* diagnostico_principal</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o diagnosticos_secundarios</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* motivo_egreso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* unidad_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o servicio_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_hora_egreso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o camilla_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* codigo_egreso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* egreso_sin_consentimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o motivo_egreso_sin_consentimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o dias_hospitalizado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o codigo_traslado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* referido_otro_hospital</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "encargado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>ENCARGADO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_encargado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#o dpi</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o telefono</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* municipio_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* area</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "enfermero" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>ENFERMERO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_enfermero</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombres</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* apellidos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* dpi</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o telefono</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* tipo</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "equipo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>EQUIPO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_equipo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o descripcion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* estado</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "especialidad" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>ESPECIALIDAD</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_especialidad</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* nombre</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "factura" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>FACTURA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_factura</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_emision</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* descripcion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* total</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o cita_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o ingreso_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o cirugia_id</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "historia_clinica" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>HISTORIA_CLINICA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_historia_clinica</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* agendamiento_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fuente_interrogatorio</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o religion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o ocupacion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o lugar_nacimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o lugar_residencia</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* antecedentes_heredofamiliares</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* antecedentes_personales_no_patologicos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* antecedentes_patologicos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* padecimiento_actual</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o interrogatorio_aparatos_sistemas</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o sintomas_generales_terapeutica</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o estudios_previos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o signos_vitales</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o exploracion_general</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o exploracion_sistematizada</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "hospital" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>HOSPITAL</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_hospital</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o informacion_especifica</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* direccion</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "hospitalizacion_insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>HOSPITALIZACION_INSUMO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_hospitalizacion_insumo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* ingreso_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* insumo_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cantidad</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* costo_unitario</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];
  "ingreso" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>INGRESO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_ingreso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* paciente_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* unidad_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o servicio_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o camilla_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* motivo_ingreso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_hora_ingreso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medico_encargado_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o diagnostico_presuntivo</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "instrumento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>INSTRUMENTO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_instrumento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* tipo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* estado</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>INSUMO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_insumo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o descripcion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o material</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o tipo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o unidad_medida</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o costo_unitario</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o stock_minimo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o stock_actual</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "medico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>MEDICO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_medico</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombres</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* apellidos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* dpi</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o telefono</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* hospital_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* municipio_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* area</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o especialidad_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* tipo_medico</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o costo_primera_consulta</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o horario_inicio</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o horario_fin</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "municipio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>MUNICIPIO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_municipio</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* departamento_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* nombre</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "paciente" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>PACIENTE</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_paciente</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* codigo_expediente</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* nombres</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* apellidos</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_nacimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* edad_años</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* sexo</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#o dpi</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o telefono</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* municipio_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* area</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o estado_civil</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o no_seguro_social</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "paciente_encargado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>PACIENTE_ENCARGADO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_paciente_encargado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* paciente_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* encargado_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* parentesco</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];
  "pago" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>PAGO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_pago</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* factura_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* numero_cuota</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* total_cuotas</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* monto</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha_pago</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "quirofano" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>QUIROFANO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_quirofano</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* hospital_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* numero</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* estado</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "receta" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>RECETA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_receta</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* consulta_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* fecha</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o proxima_cita</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "receta_medicamento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>RECETA_MEDICAMENTO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_receta_medicamento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* receta_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* medicamento_nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* dosis</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o duracion</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];
  "registro_procedimiento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>REGISTRO_PROCEDIMIENTO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_registro_procedimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cirugia_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* etapa</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* aspecto</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* exito</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o descripcion</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* hora_registro</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* enfermero_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o fecha_documentacion</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "requerimiento_quirurgico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>REQUERIMIENTO_QUIRURGICO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">#* id_requerimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* agendamiento_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* tipo_recurso</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o insumo_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o instrumento_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">o equipo_id</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">* cantidad</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];

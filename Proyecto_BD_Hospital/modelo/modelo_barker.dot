digraph hospital {
rankdir=LR;
graph [fontname="Helvetica", splines=ortho, nodesep=0.3, ranksep=0.9];
node [shape=plaintext];
edge [dir=back, arrowhead=vee, arrowtail=none, arrowsize=0.7, style=solid];
  "agendamiento_quirurgico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>AGENDAMIENTO_QUIRURGICO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_agendamiento</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">paciente_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">medico_cirujano_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">caracter</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(historia_clinica)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_procedimiento</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">tiempo_estimado_min</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_anestesia</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_hora_solicitud</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">estado_solicitud</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(motivo_rechazo)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(quirofano_solicitado_id)</FONT> *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(fecha_hora_agendada)</FONT></FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "camilla" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CAMILLA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_camilla</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">hospital_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">unidad_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">numero</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">disponible</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "chequeo_preanestesico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CHEQUEO_PREANESTESICO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_chequeo_preanestesico</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">agendamiento_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">clasificacion_asa</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">medico_asa_nombre</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">plan_anestesia</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">anestesista_nombre</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "cirugia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CIRUGIA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_cirugia</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">agendamiento_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">quirofano_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">paciente_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">cirujano_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(ingreso_id)</FONT> *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_hora_inicio</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(fecha_hora_fin)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(condicion_evolucion)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">estado</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
  "cirugia_insumo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CIRUGIA_INSUMO</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_cirugia_insumo</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">cirugia_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">insumo_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">cantidad</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">costo_unitario</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];
  "cirugia_personal" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CIRUGIA_PERSONAL</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_cirugia_personal</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">cirugia_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(medico_id)</FONT> *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(enfermero_id)</FONT> *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">rol</FONT></TD></TR></TABLE>> style="rounded,dashed,filled" fillcolor="#f5f5f5"];
  "cita" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BORDER="0"><FONT POINT-SIZE="13"><B>CITA</B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><B><U>id_cita</U></B></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">paciente_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">medico_id *</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_hora</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">num_clinica</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(medio_asignacion)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">estado</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">es_reconsulta</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">es_referido</FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(costo_base)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9"><FONT COLOR="gray">(costo_aplicado)</FONT></FONT></TD></TR><TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="9">cancelada_sin_aviso</FONT></TD></TR></TABLE>> style="rounded,filled" fillcolor="white"];
